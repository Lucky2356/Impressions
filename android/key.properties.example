# Образец. Скопируйте в android/key.properties и подставьте свои значения.
# Настоящий key.properties и файл .jks в репозиторий не попадают (.gitignore).
# Как создать ключ — README, раздел «Ключ подписи Android».

# Путь к хранилищу относительно каталога android/
storeFile=impressions.jks
storePassword=ЗАМЕНИТЕ
keyAlias=impressions
# В формате PKCS12 пароль ключа совпадает с паролем хранилища.
keyPassword=ЗАМЕНИТЕ
