<?xml version="1.0" encoding="utf-8"?>
<!--
  Адаптивный значок Android: система сама обрезает его по форме, принятой на
  устройстве (круг, квадрат со скруглением, капля). Поэтому фон — сплошная
  фирменная заливка, а рисунок лежит отдельным слоем и сжат к центру, чтобы
  при любой обрезке не потерять закладку.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
