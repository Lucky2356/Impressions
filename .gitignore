**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Локальные данные приложения и артефакты сборок
*.impressions
*.apk
*.exe

# Ключ подписи Android и пароли к нему. Потеря ключа означает, что уже
# установленные копии приложения больше нельзя будет обновить, а утечка —
# что поддельную сборку нельзя отличить от настоящей.
*.jks
*.keystore
key.properties

# Исходный мастер-промт и макеты — рабочие материалы, не часть продукта
MASTER_PROMPT.md
/image/
dist/

# Артефакты неудачных golden-тестов — только для локального разбора
test/golden/failures/
